# AeroSettle — Global Aviation Payment & Settlement Platform
# Environment Configuration Template

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://aerosettle_app:password@localhost:5432/aerosettle_prod?schema=public"

# Authentication & Session Security (Auth.js / Enterprise Session Layer)
AUTH_SECRET="replace-with-32-byte-cryptographic-secret-in-production"
NEXTAUTH_URL="http://localhost:3070"

# XRP Ledger (XRPL) Infrastructure Configuration
# Supported modes: "SIMULATION" | "TESTNET_LIVE" | "MAINNET_PRODUCTION"
XRPL_EXECUTION_MODE="SIMULATION"
XRPL_TESTNET_RPC_URL="https://s.altnet.rippletest.net:51234/"
XRPL_TESTNET_WS_URL="wss://s.altnet.rippletest.net:51233/"
XRPL_MAINNET_RPC_URL="https://xrplcluster.com/"

# Server-Side KMS / HSM Wallet Signer Reference (NEVER exposed to browser/client)
# Leave blank to run in isolated, clearly labeled Simulation Mode
XRPL_SERVER_SIGNER_SEED=""

# External FX & Off-Ramp Liquidity Partner Adapters
FX_QUOTE_PROVIDER="AEROSETTLE_INSTITUTIONAL_COMPOSITE"
SANCTIONS_SCREENING_PROVIDER="MODULAR_OFAC_EU_SCREENING_ADAPTER"
